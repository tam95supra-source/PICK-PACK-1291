{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pick-pack-1291.invalid/schema/canonical-event.v1.json",
  "title": "Pick Pack 1291 Canonical Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_type", "entity_type", "entity_id", "business_date",
    "authority_epoch", "authority_seq", "service_generation", "base_version",
    "new_version", "actor", "device_id", "timestamp", "payload",
    "idempotency_key", "schema_version"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 8, "maxLength": 180},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "entity_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "entity_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "business_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "authority_epoch": {"type": "integer", "minimum": 0},
    "authority_seq": {"type": "integer", "minimum": 0},
    "service_generation": {"type": "string", "minLength": 1, "maxLength": 80},
    "base_version": {"type": "integer", "minimum": 0},
    "new_version": {"type": "integer", "minimum": 0},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "role"],
      "properties": {
        "account_id": {"type": "string", "minLength": 1, "maxLength": 180},
        "role": {"enum": ["SUPERADMIN", "ADMIN", "USER", "SYSTEM", "IMPORT"]}
      }
    },
    "device_id": {"type": "string", "maxLength": 180},
    "timestamp": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 220},
    "schema_version": {"const": 1}
  }
}
